# 复制为仓库根目录 .env；不要覆盖已有配置，不要提交或公开密钥。
# 后端监听地址由 README 中 uvicorn 命令决定，不由此模板控制。

# 可选：运行数据目录。不设置时使用仓库根目录 data/。
# DATA_DIR=/absolute/path/to/data

# 三种协议：openai_chat | openai_responses | anthropic_messages。
# 全部留空时是明确标记的无模型资料检索模式，不能自动解释补充信息。
# 配置模型意味着研究问题、补充和论文摘要可能发送到该供应商并产生用量。
LLM_PROTOCOL=openai_chat
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# BASE_URL填写API前缀，如官方服务的 /v1，不填写 /chat/completions、/responses 或 /messages。
# 可选参数支持与数据处理政策须按实际供应商核验。

ARXIV_USER_AGENT=PaperScout/0.1
# 按官方当前使用条款提供真实联系信息（如果需要），不要用伪造邮箱。
ARXIV_RATE_LIMIT_SECONDS=3.0
